# Machine 1: coordinator, storage issuer, candidate acceptance, and publication.
# Kit setup creates .env with release fields filled; replace the remaining placeholders.
# To create provider resources and print the storage values below, use
# docs/AWS_SETUP.md or docs/R2_SETUP.md and scripts/storage-setup/.

RELAY_TAG=REPLACE_WITH_APPROVED_RELAY_TAG
MPC_RELEASE_REPOSITORY=REPLACE_WITH_APPROVED_OWNER_AND_REPOSITORY
MPC_TAG=REPLACE_WITH_APPROVED_MPC_TAG
RELAY_SHA256=REPLACE_WITH_64_CHARACTER_RELAY_SHA256
MPC_SHA256=REPLACE_WITH_64_CHARACTER_MPC_SHA256
RELAY_BIN=/usr/local/bin/relay
MPC_BIN=/usr/local/bin/mpc-ceremony

# Edit WORK_ROOT, then place the initialized ceremony material in the derived
# directories documented in the rehearsal README. The coordinator public key
# must still arrive through the independent trust channel even though its local
# destination is deterministic.
WORK_ROOT=/absolute/path/to/machine-1-work
CEREMONY_ROOT=$WORK_ROOT/public
CONFIG_ROOT=$WORK_ROOT/config
KEYS_ROOT=$WORK_ROOT/keys
RUN_ROOT=$WORK_ROOT/run
TRUSTED_COORDINATOR_KEY=$WORK_ROOT/trust/coordinator-public-key.hex
STORAGE_CONFIG=$RUN_ROOT/relay-storage.json

STORAGE_PROVIDER=aws
PUBLISHED_BUCKET=REPLACE_WITH_TEST_PUBLISHED_BUCKET
PUBLISHED_BASE_URL=https://REPLACE_WITH_PUBLIC_HTTPS_ORIGIN
INBOX_BUCKET=REPLACE_WITH_TEST_PRIVATE_INBOX_BUCKET
# For AWS, the wrapper derives this endpoint from the selected profile's
# region. For R2, set the account endpoint explicitly below.
STORAGE_ENDPOINT=
COORDINATOR_PROFILE=relay-ceremony

# Extra time beyond the signed five-minute rehearsal witness lead, allowing
# Machines 2 and 3 to observe the closure before the beacon exists.
REHEARSAL_WITNESS_BUFFER_SECONDS=120

# AWS-only values. The wrapper reads the region and account ID through AWS CLI
# and constructs GRANT_ROLE_ARN from GRANT_ROLE_NAME. Set AWS_REGION or the full
# ARN only to override discovery.
AWS_REGION=
ISSUER_PROFILE=relay-ceremony
GRANT_ROLE_NAME=relay-ceremony-inbox-grant
GRANT_ROLE_ARN=
GRANT_ROLE_MAX_TTL=1h

# R2-only values. Set STORAGE_PROVIDER=r2 and replace these for R2.
# The configure and grant scripts prompt separately for the control-plane and
# inbox-parent tokens; do not store either token in this file.
R2_ACCOUNT_ID=
R2_PARENT_ACCESS_KEY_ID=
# Required only for R2:
# STORAGE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com

# Exact proof-tool test checkout, used only for same-host operational fixtures.
PROOF_TOOL_ROOT=/absolute/path/to/proof-tool
