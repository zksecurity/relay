# Machine 1: coordinator, storage issuer, candidate acceptance, and publication.
# Kit setup creates .env with release fields filled; replace the remaining placeholders.
# To create provider resources and print the storage values below, use
# docs/AWS_SETUP.md or docs/R2_SETUP.md and scripts/storage-setup/.

RELAY_TAG=REPLACE_WITH_APPROVED_RELAY_TAG
MPC_RELEASE_REPOSITORY=REPLACE_WITH_APPROVED_OWNER_AND_REPOSITORY
MPC_TAG=REPLACE_WITH_APPROVED_MPC_TAG
RELAY_SHA256=REPLACE_WITH_64_CHARACTER_RELAY_SHA256
MPC_SHA256=REPLACE_WITH_64_CHARACTER_MPC_SHA256
RELAY_BIN=/usr/local/bin/relay
MPC_BIN=/usr/local/bin/mpc-ceremony

# Ceremony-kit setup replaces WORK_ROOT with REHEARSAL_ROOT/work/machine-1.
# When using this template without the kit, replace it manually. Place the
# initialized ceremony material in the derived directories documented in the
# rehearsal README. The coordinator public key must still arrive through the
# independent trust channel even though its local destination is deterministic.
WORK_ROOT=/absolute/path/to/machine-1-work
CEREMONY_ROOT=$WORK_ROOT/public
CONFIG_ROOT=$WORK_ROOT/config
KEYS_ROOT=$WORK_ROOT/keys
RUN_ROOT=$WORK_ROOT/run
TRUSTED_COORDINATOR_KEY=$WORK_ROOT/trust/coordinator-public-key.hex
STORAGE_CONFIG=$RUN_ROOT/relay-storage.json

STORAGE_PROVIDER=aws
PUBLISHED_BUCKET=REPLACE_WITH_TEST_PUBLISHED_BUCKET
PUBLISHED_BASE_URL=https://REPLACE_WITH_PUBLIC_HTTPS_ORIGIN
INBOX_BUCKET=REPLACE_WITH_TEST_PRIVATE_INBOX_BUCKET
# For AWS, the wrapper derives this endpoint from the selected profile's
# region. For R2, set the account endpoint explicitly below.
STORAGE_ENDPOINT=
COORDINATOR_PROFILE=relay-ceremony

# Extra time beyond the signed five-minute rehearsal witness lead, allowing
# Machines 2 and 3 to observe the closure before the beacon exists.
REHEARSAL_WITNESS_BUFFER_SECONDS=120

# Grant lifetimes. The tiny rehearsal completes each turn in seconds, so the
# defaults are deliberately short-lived. A production-sized (K=21) turn can
# spend the better part of an hour on the contribution alone before its
# upload starts: raise these accordingly (for example 4h / 30m) when driving
# a production-sized ceremony with these scripts. R2 grants must stay within
# the 168h provider limit.
PARTICIPANT_GRANT_TTL=1h
PARTICIPANT_GRANT_MIN_UPLOAD_WINDOW=15m
EVIDENCE_GRANT_TTL=1h
EVIDENCE_GRANT_MIN_UPLOAD_WINDOW=15m

# AWS-only values. The wrapper reads the region and account ID through AWS CLI
# and constructs GRANT_ROLE_ARN from GRANT_ROLE_NAME.
# Recommended: set AWS_REGION explicitly to the region the buckets live in.
# SSO / AssumeRole profiles frequently have no default region configured, and
# the buckets need not be in us-east-1; leaving this blank then makes endpoint
# discovery silently pick the wrong region. Set the full ARN only to override
# GRANT_ROLE_NAME-based discovery.
AWS_REGION=
ISSUER_PROFILE=relay-ceremony
GRANT_ROLE_NAME=relay-ceremony-inbox-grant
GRANT_ROLE_ARN=
GRANT_ROLE_MAX_TTL=1h

# R2-only values. The Wrangler-backed setup fills these automatically. Secret
# values remain outside this file: it stores only protected credential-file
# paths and, for the rehearsal, the trusted Wrangler executable used to refresh
# its OAuth control token. Relay prefers R2_PARENT_SECRET_FILE for local
# temporary-credential signing. Leave the source fields empty when using
# prompts.
R2_ACCOUNT_ID=
R2_PARENT_ACCESS_KEY_ID=
R2_PARENT_TOKEN_FILE=
R2_PARENT_SECRET_FILE=
R2_CONTROL_TOKEN_FILE=
R2_CONTROL_WRANGLER_BIN=
# Required only for R2:
# STORAGE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com

# Exact proof-tool source checkout, used only by the optional operational
# fixtures (step 33). Check it out at the approved MPC_TAG commit; the step
# builds a helper from it with a locally installed Go toolchain, so kit-only
# machines that skip steps 33-42 can leave this placeholder in place.
PROOF_TOOL_ROOT=/absolute/path/to/proof-tool
