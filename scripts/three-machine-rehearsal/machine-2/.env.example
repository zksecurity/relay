# Machine 2: participant-01, participant-03, witness-01, mirror-01, auditor-01.
# Copy to .env on Machine 2, replace every placeholder, then chmod 0600 .env.

RELAY_BIN=/absolute/path/to/relay
MPC_BIN=/absolute/path/to/mpc-ceremony
RELAY_SHA256=REPLACE_WITH_64_CHARACTER_RELAY_SHA256
MPC_SHA256=REPLACE_WITH_64_CHARACTER_LOCAL_MPC_SHA256

# Local copies of public ceremony trust material and this machine's keys.
CEREMONY_ROOT=/absolute/path/to/ceremony-trust
CONFIG_ROOT=/absolute/path/to/config
KEYS_ROOT=/absolute/path/to/machine-2-keys
RUN_ROOT=/absolute/path/to/machine-2-run
TRUSTED_COORDINATOR_KEY=/absolute/path/to/trusted/coordinator-public-key.hex
STORAGE_CONFIG=/absolute/path/to/relay-storage.json

PUBLISHED_BUCKET=REPLACE_WITH_TEST_PUBLISHED_BUCKET
STORAGE_ENDPOINT=https://s3.us-east-1.amazonaws.com
PUBLISHED_READER_PROFILE=relay-test-published-reader
