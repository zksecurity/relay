# Cloudflare account and zone that own the R2 buckets and public hostname.
R2_ACCOUNT_ID=REPLACE_WITH_32_CHARACTER_ACCOUNT_ID
R2_ZONE_ID=REPLACE_WITH_32_CHARACTER_ZONE_ID

# Use ceremony-specific bucket names. Relay currently requires the default R2
# jurisdiction because its privacy check does not send a jurisdiction header.
PUBLISHED_BUCKET=REPLACE_WITH_PUBLISHED_BUCKET
INBOX_BUCKET=REPLACE_WITH_PRIVATE_INBOX_BUCKET
PUBLISHED_CUSTOM_DOMAIN=ceremony.example.org

# AWS CLI profile name used by Relay for coordinator access to both buckets.
# The setup script prompts for its R2 Access Key ID and Secret Access Key.
COORDINATOR_PROFILE=relay-r2-coordinator

# Access Key ID of a separate Object Read & Write R2 API token scoped only to
# INBOX_BUCKET. Keep its API token value outside this file; Relay prompts for it.
R2_PARENT_ACCESS_KEY_ID=REPLACE_WITH_PARENT_ACCESS_KEY_ID

# Required acknowledgement. The script creates the two buckets, disables their
# r2.dev domains, and attaches the custom domain only to PUBLISHED_BUCKET.
CONFIRM_CREATE=yes
