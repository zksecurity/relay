# Existing AWS CLI profile allowed to create S3, CloudFront, and IAM resources.
AWS_SETUP_PROFILE=REPLACE_WITH_PROVISIONING_PROFILE
AWS_REGION=us-east-1

# Use globally unique, ceremony-specific bucket names.
PUBLISHED_BUCKET=REPLACE_WITH_UNIQUE_PUBLISHED_BUCKET
INBOX_BUCKET=REPLACE_WITH_UNIQUE_PRIVATE_INBOX_BUCKET

# Existing runtime profiles. Both must authenticate to the same AWS account as
# AWS_SETUP_PROFILE. The setup script does not create access keys.
COORDINATOR_PROFILE=relay-coordinator
ISSUER_PROFILE=relay-issuer

# IAM users or roles authenticated by the runtime profiles. Use IAM ARNs, not
# sts::assumed-role session ARNs. The script attaches least-privilege inline
# policies to these principals.
COORDINATOR_PRINCIPAL_ARN=arn:aws:iam::123456789012:role/REPLACE_WITH_COORDINATOR_ROLE
ISSUER_PRINCIPAL_ARN=arn:aws:iam::123456789012:role/REPLACE_WITH_ISSUER_ROLE

GRANT_ROLE_NAME=relay-inbox-grant
# Whole hours only; AWS permits 1h through 12h. Role chaining still caps grants
# at 1h, so use a direct issuer identity if longer grants are required.
GRANT_ROLE_MAX_TTL=1h

# Required acknowledgement. The script creates or updates named AWS resources
# but never deletes buckets, objects, distributions, roles, or policies.
CONFIRM_CREATE=yes
