# One existing AWS CLI profile with permission to provision and operate Relay.
# The setup script never creates or stores access keys.
AWS_PROFILE=relay-ceremony

# Resources are derived from this prefix and your 12-digit AWS account ID.
# Override individual names below only when an existing naming scheme requires it.
RESOURCE_PREFIX=relay-ceremony
AWS_REGION=
PUBLISHED_BUCKET=
INBOX_BUCKET=
GRANT_ROLE_NAME=

# Whole hours only; AWS permits 1h through 12h. Role chaining still caps grants
# at 1h, even if this value is higher.
GRANT_ROLE_MAX_TTL=1h

# Required acknowledgement. The script creates or updates named AWS resources
# but never deletes buckets, objects, distributions, roles, or policies.
CONFIRM_CREATE=yes
